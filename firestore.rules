rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.email == 'admin@fxecdigital.org'); }

    match /students/{id} {
      allow create: if false;
      allow read: if admin() || (signedIn() && request.auth.uid == id);
      allow update: if admin();
      allow delete: if admin();
    }

    match /assessmentSchedules/{id} {
      allow read: if signedIn() && (admin() || resource.data.isPublished == true);
      allow write: if admin();
    }

    match /questionPools/{id} {
      allow read, write: if admin();
    }

    match /attempts/{id} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow update, delete: if admin();
    }


    match /assessmentSubmissions/{id} {
      // Students only need permission to create a submission. The Cloud
      // Firestore trigger performs the authoritative ownership, question,
      // scoring and deadline checks using the Admin SDK.
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /results/{id} {
      allow read: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if admin();
    }

    match /publicStats/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /questionBank/{id} {
      allow read, write: if admin();
    }

    match /competencyContent/{id} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if admin();
    }

    match /competencyTrackProgress/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /competencyAttempts/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /communicationSpeechAttempts/{id} {
      allow read, write: if false;
    }

    match /competencyAssessmentTasks/{id} {
      allow read: if signedIn() && (admin() || resource.data.isPublished == true);
      allow write: if false;
    }

    match /competencyQuestionPools/{poolId} {
      allow read, write: if admin();
      match /questions/{questionId} {
        allow read, write: if admin();
      }
    }

    match /competencyAssessmentAttempts/{id} {
      allow read: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /competencyAssessmentResults/{id} {
      allow read: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /adminActions/{id} {
      allow create: if admin();
      allow read: if admin();
      allow update, delete: if false;
    }
  }
}
