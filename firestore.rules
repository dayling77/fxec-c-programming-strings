rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.email == 'admin@fxecdigital.org'); }

    match /students/{id} {
      allow create: if signedIn() && request.auth.uid == id;
      allow read: if admin() || (signedIn() && request.auth.uid == id);
      allow update: if admin() || (signedIn() && request.auth.uid == id);
      allow delete: if admin();
    }

    match /assessmentSchedules/{id} {
      allow read: if signedIn() && (admin() || resource.data.isPublished == true);
      allow write: if admin();
    }

    match /questionPools/{id} {
      allow read, write: if admin();
    }

    match /attempts/{id} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow update, delete: if admin();
    }


    match /assessmentSubmissions/{id} {
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.attemptId == id
        && exists(/databases/$(database)/documents/attempts/$(id))
        && get(/databases/$(database)/documents/attempts/$(id)).data.studentId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow update, delete: if admin();
    }

    match /results/{id} {
      allow read: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if admin();
    }

    match /publicStats/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /questionBank/{id} {
      allow read, write: if admin();
    }

    match /adminActions/{id} {
      allow create: if admin();
      allow read: if admin();
      allow update, delete: if false;
    }
  }
}
